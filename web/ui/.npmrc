# @metapatrol/* packages come from the forge's npm registry, which requires a
# token with read:package scope: export NPM_TOKEN=... (locally, in CI and as a
# Docker build secret). The forge uses a private CA: point NODE_EXTRA_CA_CERTS
# at it where the system does not trust it already.
@metapatrol:registry=https://forgejo.metapatrol.local/api/packages/metapatrol/npm/
//forgejo.metapatrol.local/api/packages/metapatrol/npm/:_authToken=${NPM_TOKEN}
