# Build output. `go build ./cmd/<binary>` from the root leaves the binary
# here rather than in bin/.
bin/
/mcp-gateway
/mcp-gateway-controller
/mcp-gateway-proxy
/mcp-gateway-ui

# semantic-release installs into the workspace during a release run.
node_modules/
package-lock.json
# ...but the console's lockfile is what `npm ci` installs from.
!/web/ui/package-lock.json

# The console's web UI build, which mcp-gateway-ui embeds (make ui-build).
/internal/ui/dist/*
!/internal/ui/dist/.gitkeep
